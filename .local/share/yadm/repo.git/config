[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	ignorecase = true
	precomposeunicode = true
	sharedrepository = 0600
	worktree = /Users/bash
[receive]
	denyNonFastforwards = true
[status]
	showUntrackedFiles = no
[yadm]
	managed = true
[remote "origin"]
	url = https://github.com/rackodo/dotfiles.git
	fetch = +refs/heads/*:refs/remotes/origin/*
