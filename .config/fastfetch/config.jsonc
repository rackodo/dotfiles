{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": " ",
    "bar": {
      "width": 10
    }
  },
  "modules": [
    {
      "type": "title",
      "key": "{#90}\uf054 host       {#keys}"
    },
    {
      "type": "terminal",
      "key": "{#90}\uf054 term       {#keys}"
    },
    {
      "type": "shell",
      "key": "{#90}\uf054 shell      {#keys}"
    },
    {
      "type": "packages",
      "key": "{#90}\uf054 packages   {#keys}"
    },
    {
      "type": "uptime",
      "key": "{#90}\uf054 uptime     {#keys}"
    },
    {
      "type": "command",
      "key": "{#90}\uf054 age        {#keys}",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "battery",
      "key": "{#90}\uf054 charge     {#keys}",
      "percent": {
        "type": ["bar", "num"]
      },
      "format": "{10} {4}"
    }
  ]
}
